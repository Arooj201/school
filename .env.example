# Copy this file to .env and fill in real values before running the server.

# PostgreSQL connection (Railway/Render give you this automatically)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret used to sign login tokens — use a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret-string

# Port the API server runs on
PORT=4000

# Comma-separated list of allowed frontend origins (for CORS)
CORS_ORIGIN=http://localhost:5500
